# ============================================================
# Pagoda Travel AI Matching Service — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---------------------------
# Required
# ---------------------------

# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Pagoda Pro Supabase (required for live Tour Library)
# Local mock: keep USE_MOCK_TOURS=true and the placeholder URL/key
SUPABASE_URL=https://mock.supabase.local
SUPABASE_ANON_KEY=mock-anon-key
USE_MOCK_TOURS=true

# ---------------------------
# Optional (defaults shown)
# ---------------------------

# Comma-separated list of allowed CORS origins (* = all)
ALLOWED_ORIGINS=*

# Port to run the service on (default: 8000)
PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Service environment label (used in logs)
ENVIRONMENT=development
